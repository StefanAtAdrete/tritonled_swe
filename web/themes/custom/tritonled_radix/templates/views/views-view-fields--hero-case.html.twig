{#
/**
 * @file
 * Hero case fields — media background + caption overlay + stretched-link.
 * Renders field_hero_media first, falls back to field_media for existing cases.
 */
#}

{# Media background #}
<div class="position-absolute top-0 start-0 w-100 h-100">
  {% if fields.field_hero_media is not empty and fields.field_hero_media.content is not empty %}
    {{ fields.field_hero_media.content }}
  {% elseif fields.field_media is not empty and fields.field_media.content is not empty %}
    {{ fields.field_media.content }}
  {% endif %}
</div>

{# Text overlay med stretched-link #}
<div class="carousel-caption text-start ps-5" style="max-width: 60%;">
  {% if fields.title is not empty %}
    <h3 class="fw-lighter">
      {% if fields.view_node is not empty %}
        <a href="{{ fields.view_node.content|render|striptags|trim }}" class="stretched-link text-white text-decoration-none">
          {{ fields.title.content }}
        </a>
      {% else %}
        {{ fields.title.content }}
      {% endif %}
    </h3>
  {% endif %}
</div>
