{#
/**
 * @file
 * commerce-product--card.html.twig
 *
 * Bootstrap product card — used in Views with "Rendered entity" + card view mode.
 * NOTE: Commerce uses {{ product.field_xxx }} not {{ content.field_xxx }}
 */
#}
{%- set env_term = product.field_installation_environment|render|striptags|trim -%}
{%- set badge_class = 'bg-secondary' -%}
{%- if 'Ex-miljö' in env_term -%}
  {%- set badge_class = 'bg-warning text-dark' -%}
{%- elseif 'Utomhus' in env_term -%}
  {%- set badge_class = 'bg-success' -%}
{%- elseif 'Lager' in env_term -%}
  {%- set badge_class = 'bg-primary' -%}
{%- elseif 'Gata' in env_term -%}
  {%- set badge_class = 'bg-dark' -%}
{%- elseif 'Kontor' in env_term -%}
  {%- set badge_class = 'bg-info text-dark' -%}
{%- elseif 'Installation' in env_term -%}
  {%- set badge_class = 'bg-secondary' -%}
{%- endif -%}
{%- set watt = product.field_watt_range|render|striptags|trim -%}
{%- set lumen = product.field_lumen_range|render|striptags|trim -%}

<article class="triton-product-card card h-100 border-0 shadow-sm">

  <div class="triton-card-img position-relative">
    {{ product.field_product_media }}
    {% if env_term %}
      <span class="badge {{ badge_class }} position-absolute top-0 end-0 m-2">
        {{ env_term }}
      </span>
    {% endif %}
  </div>

  <div class="card-body d-flex flex-column px-3 py-2">
    <h3 class="card-title h6 mb-2 fw-semibold">
      {{ product.title }}
    </h3>
    {% if product.field_short_description|render|striptags|trim %}
      <div class="triton-card-features text-muted small flex-grow-1">
        {{ product.field_short_description }}
      </div>
    {% endif %}
    {% if watt or lumen %}
      <div class="triton-card-foot border-top mt-2 pt-2 d-flex justify-content-between align-items-baseline">
        <span class="small fw-medium text-dark">
          {%- if watt and lumen -%}
            {{ watt }} · {{ lumen }}
          {%- elseif watt -%}
            {{ watt }}
          {%- else -%}
            {{ lumen }}
          {%- endif -%}
        </span>
      </div>
    {% endif %}
  </div>

</article>
