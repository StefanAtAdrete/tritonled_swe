<?php

declare(strict_types=1);

namespace Drupal\Tests\{{ machine_name }}\Kernel\Tool;

use Drupal\KernelTests\KernelTestBase;
use Drupal\{{ machine_name }}\Plugin\tool\Tool\{{ class }};
use PHPUnit\Framework\Attributes\CoversClass;
use PHPUnit\Framework\Attributes\Group;
use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;

/**
 * Tests execution of the {{ plugin_label }} tool.
 */
#[CoversClass({{ class }}::class)]
#[Group('{{ machine_name }}')]
#[RunTestsInSeparateProcesses]
final class {{ class }}Test extends KernelTestBase {

  /**
   * {@inheritdoc}
   */
  protected static $modules = ['tool', '{{ machine_name }}', 'user'];

  /**
   * The tool plugin manager.
   *
   * @var \Drupal\tool\Tool\ToolManager
   */
  protected $toolManager;

  /**
   * {@inheritdoc}
   */
  protected function setUp(): void {
    parent::setUp();
    // @todo If the tool touches entities, install their schema here, e.g.
    //   $this->installEntitySchema('node');
    $this->toolManager = $this->container->get('plugin.manager.tool');
  }

  /**
   * Tests a successful execution with valid input.
   */
  public function testSuccessfulExecution(): void {
    $tool = $this->toolManager->createInstance('{{ plugin_id }}');
    $tool->setInputValue('example', 'widget');
    $tool->execute();

    $result = $tool->getResult();
    $this->assertTrue($result->isSuccess());
    $this->assertStringContainsString('widget', (string) $result->getMessage());
    // Output keys must match output_definitions to be populated.
    $this->assertSame(['example' => 'widget'], $tool->getOutputValue('result'));
  }

  /**
   * Tests that a missing required input produces a failure result.
   */
  public function testMissingRequiredInputFails(): void {
    $tool = $this->toolManager->createInstance('{{ plugin_id }}');
    // The required 'example' input is not set.
    $tool->execute();

    $this->assertFalse($tool->getResult()->isSuccess());
  }

}
