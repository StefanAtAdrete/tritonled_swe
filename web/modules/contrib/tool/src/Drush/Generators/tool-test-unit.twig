<?php

declare(strict_types=1);

namespace Drupal\Tests\{{ machine_name }}\Unit\Tool;

use Drupal\Core\Session\AccountInterface;
use Drupal\{{ machine_name }}\Plugin\tool\Tool\{{ class }};
use Drupal\Tests\UnitTestCase;
use PHPUnit\Framework\Attributes\CoversClass;
use PHPUnit\Framework\Attributes\Group;

/**
 * Tests access control for the {{ plugin_label }} tool.
 */
#[CoversClass({{ class }}::class)]
#[Group('{{ machine_name }}')]
final class {{ class }}AccessTest extends UnitTestCase {

  /**
   * Invokes the protected checkAccess() on a directly-built plugin.
   *
   * @param array $values
   *   The executable input values.
   * @param \Drupal\Core\Session\AccountInterface $account
   *   The account to check access for.
   *
   * @return bool
   *   The access result.
   */
  private function checkAccess(array $values, AccountInterface $account): bool {
    // Constructor: (configuration, plugin_id, plugin_definition, currentUser).
    $tool = new {{ class }}([], '{{ plugin_id }}', [], $account);
    $method = new \ReflectionMethod({{ class }}::class, 'checkAccess');
    return $method->invoke($tool, $values, $account, FALSE);
  }

  /**
   * The generated checkAccess() is fail-closed: it throws until access is real.
   *
   * @todo Once the real access rule is approved, replace this with allowed and
   *   denied cases asserting the permission or entity access check.
   */
  public function testAccessIsFailClosed(): void {
    $this->expectException(\LogicException::class);
    $this->checkAccess(['example' => 'value'], $this->createMock(AccountInterface::class));
  }

}
