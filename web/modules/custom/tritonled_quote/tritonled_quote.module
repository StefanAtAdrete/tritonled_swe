<?php

use Drupal\commerce_order\Entity\OrderInterface;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Form\FormStateInterface;

/**
 * @file
 * Quote checkout customizations for TritonLED.
 *
 * This module removes unit_price field from Quote order checkout while
 * preserving price data in the database for JSON/API exports.
 *
 * @see /docs/modules/custom/tritonled_quote-DECISION.md
 */

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 *
 * Remove unit_price field from Quote order items table in checkout.
 *
 * Business requirement:
 * - Fas 1: Quote-based system with no public pricing in checkout UI
 * - Prices must remain in database for future JSON/API exports to partners
 * - Visual hiding via CSS is insufficient (prices would be in HTML source)
 *
 * Technical implementation:
 * - Removes 'unit_price' from the fields array before table is built
 * - Server-side removal ensures prices never render in HTML
 * - Database values remain untouched for API/export functionality
 *
 * Future enhancement (Fas 2):
 * When e-commerce is added alongside Quote system, this hook should be
 * enhanced to conditionally remove unit_price only for Quote orders:
 *
 * @code
 * // Get parent order from form state to check bundle
 * if ($parent_order && $parent_order->bundle() === 'quote') {
 *   unset($fields['unit_price']);
 * }
 * @endcode
 *
 * @param array $fields
 *   The fields to be displayed in the IEF table, keyed by field name.
 * @param array $context
 *   Context array with keys:
 *   - parent_entity_type: The type of the parent entity.
 *   - parent_bundle: The bundle of the parent entity.
 *   - field_name: The name of the reference field.
 *   - entity_type: The type of the referenced entities.
 *   - allowed_bundles: Bundles allowed on the reference field.
 *
 * @see \Drupal\commerce_order\Form\OrderItemInlineForm::getTableFields()
 * @see \Drupal\inline_entity_form\Plugin\Field\FieldWidget\InlineEntityFormComplex::formElement()
 */
function tritonled_quote_inline_entity_form_table_fields_alter(array &$fields, array $context) {
  // Only act on commerce_order_item entities.
  if ($context['entity_type'] !== 'commerce_order_item') {
    return;
  }

  // Only act when parent is a commerce_order.
  // This ensures we're modifying checkout context, not admin forms.
  if ($context['parent_entity_type'] !== 'commerce_order') {
    return;
  }

  // Fas 1: Remove unit_price for all orders.
  // Currently only Quote orders exist, so this is safe.
  // Fas 2 TODO: Add conditional check for order bundle here.
  if (isset($fields['unit_price'])) {
    unset($fields['unit_price']);
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Validation rule:
 * If quote stage is "lost", require lost reason and comment.
 */
function tritonled_quote_entity_presave(\Drupal\Core\Entity\EntityInterface $entity) {
  if (!$entity instanceof OrderInterface || $entity->bundle() !== 'quote') {
    return;
  }

  if (!$entity->hasField('field_quote_stage')) {
    return;
  }

  $stage = (string) $entity->get('field_quote_stage')->value;
  if ($stage !== 'lost') {
    return;
  }

  $lost_reason = $entity->hasField('field_lost_reason') ? (string) $entity->get('field_lost_reason')->value : '';
  $lost_comment = $entity->hasField('field_lost_comment') ? trim((string) $entity->get('field_lost_comment')->value) : '';

  if ($lost_reason === '' || $lost_comment === '') {
    throw new EntityStorageException('Förlorad offert kräver både Förlorad orsak och Förlorad kommentar.');
  }
}

/**
 * Implements hook_entity_update().
 *
 * Sends customer email when quote stage changes to "sent".
 */
function tritonled_quote_entity_update(\Drupal\Core\Entity\EntityInterface $entity) {
  if (!$entity instanceof OrderInterface || $entity->bundle() !== 'quote') {
    return;
  }

  if (!$entity->hasField('field_quote_stage')) {
    return;
  }

  $new_stage = (string) $entity->get('field_quote_stage')->value;
  $old_stage = '';

  if ($entity->original instanceof OrderInterface && $entity->original->hasField('field_quote_stage')) {
    $old_stage = (string) $entity->original->get('field_quote_stage')->value;
  }

  // Only trigger on transition into sent.
  if ($new_stage !== 'sent' || $old_stage === 'sent') {
    return;
  }

  $to = (string) $entity->getEmail();
  if ($to === '') {
    return;
  }

  $mail_manager = \Drupal::service('plugin.manager.mail');
  $langcode = \Drupal::currentUser()->getPreferredLangcode();
  $params = [
    'subject' => 'Offert skickad',
    'message' => 'Din offert ' . ($entity->getOrderNumber() ?: ('#' . $entity->id())) . ' har uppdaterats och skickats.',
  ];

  $mail_manager->mail('tritonled_quote', 'quote_sent', $to, $langcode, $params);
}

/**
 * Implements hook_mail().
 */
function tritonled_quote_mail($key, &$message, $params) {
  if ($key !== 'quote_sent') {
    return;
  }

  $message['subject'] = $params['subject'] ?? 'Offert skickad';
  $message['body'][] = $params['message'] ?? 'Din offert har skickats.';
}

/**
 * Implements hook_form_alter().
 *
 * Shows a variant dropdown on quote add-to-cart forms for all product bundles
 * except MAX/OPTI/SROW bundle, and preselects single-variant products.
 */
function tritonled_quote_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (strpos($form_id, 'commerce_order_item_add_to_cart_form_') !== 0) {
    return;
  }

  $form_object = $form_state->getFormObject();
  $order_item = $form_object ? $form_object->getEntity() : NULL;
  if (!$order_item || $order_item->bundle() !== 'quote') {
    return;
  }

  $product = $form_state->get('product');
  if (!$product) {
    return;
  }

  if (in_array($product->bundle(), ['led_luminaire_max_opti', 'led_luminaire_srow'], TRUE)) {
    return;
  }

  if (empty($form['purchased_entity']['widget'][0]['variation'])) {
    return;
  }

  $variations = $product->getVariations();
  if (empty($variations)) {
    return;
  }

  $options = [];
  foreach ($variations as $variation) {
    $variation_id = (string) $variation->id();
    if ($variation_id === '') {
      continue;
    }
    $sku = trim((string) $variation->getSku());
    $variation_label = trim((string) $variation->label());
    if ($sku !== '' && $variation_label !== '') {
      $option_label = $sku . ' — ' . $variation_label;
    }
    elseif ($sku !== '') {
      $option_label = $sku;
    }
    elseif ($variation_label !== '') {
      $option_label = $variation_label;
    }
    else {
      $option_label = 'Variant ' . $variation_id;
    }
    $options[$variation_id] = $option_label;
  }

  $default_variation = (string) ($form['purchased_entity']['widget'][0]['variation']['#value'] ?? '');
  if ($default_variation === '' || !isset($options[$default_variation])) {
    $default_variation = (string) array_key_first($options);
  }

  $form['purchased_entity']['widget'][0]['variation_selector'] = [
    '#type' => 'select',
    '#title' => 'Variant',
    '#options' => $options,
    '#default_value' => $default_variation,
    '#weight' => -5,
  ];

  $form['#validate'][] = 'tritonled_quote_add_to_cart_variant_validate';
}

/**
 * Validation callback for add-to-cart: map variant select to purchased_entity.
 */
function tritonled_quote_add_to_cart_variant_validate(array &$form, FormStateInterface $form_state) {
  $selected = $form_state->getValue(['purchased_entity', 0, 'variation_selector']);
  if (empty($selected)) {
    return;
  }

  $selected = (string) $selected;
  $form_state->setValue(['purchased_entity', 0, 'variation'], $selected);
  $form_state->setValue(['purchased_entity', 0, 'target_id'], $selected);
}
